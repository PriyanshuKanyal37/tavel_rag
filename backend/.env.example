# Copy to backend/.env and fill in. Never commit the filled-in file.
# On Render these are set on the service instead, not read from a file.

# --- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Neon Postgres --------------------------------------------------------
# PILOT_DSN is the pooled connection used by every query.
# PILOT_DSN_DIRECT is unpooled, for DDL and index builds. Falls back to PILOT_DSN.
PILOT_DSN=
PILOT_DSN_DIRECT=

# --- Cloudflare R2 (source documents and page images) ---------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Cookies --------------------------------------------------------------
# COOKIE_SECURE=0 ONLY for local http development. 1 everywhere else.
COOKIE_SECURE=1
COOKIE_SAMESITE=strict

# --- Rate limits on the one endpoint that spends money --------------------
ASK_PER_MIN=60
ASK_PER_MIN_ALL=120
